# .env 템플릿 — install_mac.sh 가 복사해 값을 물어본다. 수동이면: cp .env.example .env
# ⚠️ 실제 `.env` 는 절대 커밋하지 말 것(.gitignore 처리됨).

# --- 발송용 Gmail (앱 비밀번호 필요) --------------------------------
# Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호 에서 생성한 16자리.
GMAIL_USER=nasong27@gmail.com
GMAIL_APP_PASSWORD=

# --- 기본 수신자 (쉼표 구분) ----------------------------------------
# 웹 관리 > 수신자에 한 명이라도 등록돼 있으면 그쪽이 우선이다.
REPORT_TO=

# --- 기본 키워드 (쉼표 구분) ----------------------------------------
# 웹 관리 > 키워드에 등록돼 있으면 그쪽이 우선이다.
KEYWORDS=현대카드,현카,현대카드 챗봇,현대카드 헨리,현카 헨리

# --- 분류기 -------------------------------------------------------
# CLASSIFIER: auto(기본) = 이 Mac 의 Claude Code(본인 구독) 먼저, 실패 시 API 키
#             claude-code = 구독만 / api = API 키만
# Claude Code 는 터미널에서 'claude' 를 한 번 실행해 로그인해 두면 된다.
CLASSIFIER=auto
CLAUDE_MODEL=claude-sonnet-5-5
# API 키: 구독 경로 실패 시 대체용(console.anthropic.com). 둘 다 안 되면 키워드 분류.
ANTHROPIC_API_KEY=
# (선택) claude 실행 파일 위치를 못 찾을 때만
CLAUDE_BIN=

# --- 웹 대시보드 공유 DB (Neon Postgres) --------------------------
# Vercel 프로젝트 > Storage > Neon 의 DATABASE_URL 과 같은 값.
DATABASE_URL=

# --- X(트위터) 보조 수집 (베스트에포트, 없어도 됨) ------------------
X_ACCOUNT=
X_PASSWORD=
X_USERNAME=
