# 웹(Vercel) 환경변수 — Vercel 프로젝트 > Settings > Environment Variables 에 입력.
# 로컬 개발 시에만 이 파일을 .env.local 로 복사해 사용.

# Neon 연결 시 자동 추가됨
DATABASE_URL=

# 로그인: 팀 공용 비밀번호 / 관리자 비밀번호 / 세션 서명 키(아무 긴 랜덤 문자열 32자 이상)
SITE_PASSWORD=
ADMIN_PASSWORD=
AUTH_SECRET=

# 웹에서 즉석 발송용 (Mac .env 와 같은 Gmail 앱 비밀번호)
GMAIL_USER=nasong27@gmail.com
GMAIL_APP_PASSWORD=

# 클라우드 백업 수집(관리 > 운영 > 지금 클라우드로 수집)에서 Claude 분류용
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
